# ─────────────────────────────────────────────────────────────────────────────
# Swarna Prabha — server environment. Copy to server/.env and fill in.
# Never commit a real .env. All values below are placeholders / safe dev defaults.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL. `docker compose up -d --wait db` (or `npm run db:up`) starts a
# pgvector/pgvector:pg16 container on host port 5434 with these credentials and
# creates the goldenaura / goldenaura_shadow / goldenaura_test databases.
DATABASE_URL=postgresql://goldenaura:goldenaura@localhost:5434/goldenaura?schema=public
# Only needed for `prisma migrate dev` (shadow DB). Not needed in production.
SHADOW_DATABASE_URL=postgresql://goldenaura:goldenaura@localhost:5434/goldenaura_shadow?schema=public

# Auth — generate long random values for anything non-local.
JWT_ACCESS_SECRET=change-me-min-8-chars
JWT_REFRESH_SECRET=change-me-min-8-chars
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# CORS + cookies. CORS_ORIGIN is the client origin (comma-separated for several).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=
TRUST_PROXY=0

# File storage: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
# s3 driver (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Payments: manual only (records real Payment rows, confirmed by a human).
PAYMENT_DRIVER=manual

# Mail: console | smtp
MAIL_DRIVER=console
MAIL_FROM="Swarna Prabha <no-reply@swarnaprabha.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Seed accounts (used by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@swarnaprabha.local
SEED_ADMIN_PASSWORD=change-me
SEED_JEWELLER_EMAIL=jeweller@swarnaprabha.local
SEED_JEWELLER_PASSWORD=change-me
SEED_CUSTOMER_EMAIL=customer@swarnaprabha.local
SEED_CUSTOMER_PASSWORD=change-me
